{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["tools/**/*", "api/**/*"],
  "compilerOptions": {
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@/*": ["src/renderer/src/*"]
    }
  }
}
